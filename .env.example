# Odoo MCP Server Configuration
# Copy this file to .env and fill in your values

# Required Odoo connection (used directly in single/shared-identity mode)
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-database
ODOO_USERNAME=your-username

# Authentication (use API key OR password)
ODOO_API_KEY=your-api-key
# ODOO_PASSWORD=your-password

# Optional Odoo connection settings
# ODOO_TIMEOUT=30
# ODOO_VERIFY_SSL=true

# Transport (default: stdio)
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8080
# MCP_VERBOSE=true
# MCP_SERVER_NAME=KasbifyDev
# MCP_WEBSITE_URL=https://github.com/jaavid/odoo-mcp-19

# -----------------------------------------------------------------------------
# MCP client authentication
# -----------------------------------------------------------------------------
# Modes: auto (default), oidc, registry, static, none.
# auto selects oidc when MCP_OIDC_ISSUER is present, otherwise registry/static.
# MCP_AUTH_MODE=auto

# Legacy/static bearer fallback. This can remain enabled alongside OIDC so
# existing non-ChatGPT integrations do not break during migration.
# MCP_API_KEY=your-secret-bearer-token

# -----------------------------------------------------------------------------
# OAuth/OIDC for ChatGPT and other OAuth-capable MCP clients
# -----------------------------------------------------------------------------
# FastMCP 3.4.x can use Keycloak 26.6+ as the remote authorization server.
# On Alpic, MCP_PUBLIC_URL may be omitted because ALPIC_HOST is provided by the
# platform automatically. For other hosts, set the public origin explicitly.
# MCP_AUTH_MODE=oidc
# MCP_PUBLIC_URL=https://mcp.example.com
# MCP_OIDC_ISSUER=https://auth.example.com/realms/engineering
# MCP_OIDC_JWKS_URI=https://auth.example.com/realms/engineering/protocol/openid-connect/certs
# MCP_OIDC_ALGORITHM=RS256
# MCP_OIDC_EMAIL_CLAIM=email
# MCP_OIDC_SCOPES=openid,profile,email,mcp:tools,mcp:resources,mcp:prompts

# Strongly recommended in production. Set this to the exact protected MCP
# resource URL advertised by /.well-known/oauth-protected-resource (normally
# the public FastMCP streamable-HTTP endpoint, e.g. https://mcp.example.com/mcp).
# Configure Keycloak audience mappers so the same value is present in access
# token `aud`.
# MCP_OIDC_AUDIENCE=https://mcp.example.com/mcp

# OIDC identity mode:
# - shared: verified users operate through the env-configured Odoo account.
# - registry: verified email maps to users.db and personal Odoo credentials.
# If omitted, registry is selected when USERS_DB_PATH exists; otherwise shared.
# MCP_OIDC_IDENTITY_MODE=shared

# Shared identity authorization. readonly is the safe default. Use support only
# when write-capable ChatGPT actions are intentionally enabled; strict safety
# confirmation still applies to writes.
# MCP_OIDC_SHARED_ROLE=readonly
# MCP_OIDC_REQUIRED_REALM_ROLE=kasbifydev
# Optional extra restriction; comma-separated and case-insensitive.
# MCP_OIDC_ALLOWED_EMAILS=user1@example.com,user2@example.com

# -----------------------------------------------------------------------------
# Per-user registry mode
# -----------------------------------------------------------------------------
# The registry is read-only to this process. In OIDC registry mode, a verified
# email claim must resolve to exactly one active registry user. That user's
# encrypted Odoo API key is then used for attribution and authorization.
# TOKEN_ENCRYPTION_KEY and .token_salt MUST match the registry owner's values.
# USERS_DB_PATH=/registry/users.db
# TOKEN_ENCRYPTION_KEY=must-equal-registry-value
# TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/token_encryption_key

# Safety Layer
# MCP_SAFETY_MODE=strict
# MCP_SAFETY_AUDIT=true
# MCP_READ_ONLY=false
# MCP_WRITE_ALLOWLIST=project.task.write,project.task.create

# DX
# MCP_DEFAULT_CONTEXT={"lang": "fa_IR", "tz": "Asia/Tehran"}
# MCP_BOOTSTRAP_MODELS=project.project,project.task,crm.lead,calendar.event,res.partner
