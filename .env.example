# Odoo MCP Server Configuration
# Copy this file to .env and fill in your values

# Required
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-database
ODOO_USERNAME=your-username

# Authentication (use API key OR password)
ODOO_API_KEY=your-api-key
# ODOO_PASSWORD=your-password

# Optional
# ODOO_TIMEOUT=30
# ODOO_VERIFY_SSL=true

# Transport (default: stdio)
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8080
# MCP_VERBOSE=true              # Slant-ASCII startup banner to stderr (false to silence)
# MCP_SERVER_NAME=KasbifyDev
# MCP_WEBSITE_URL=https://github.com/jaavid/odoo-mcp-19

# -----------------------------------------------------------------------------
# MCP client authentication
# -----------------------------------------------------------------------------
# Modes: auto (default), oidc, registry, static, none.
# auto selects oidc when MCP_OIDC_ISSUER is present, otherwise registry/static.
# MCP_AUTH_MODE=auto

# Legacy/static bearer fallback. This remains usable alongside OIDC when
# USERS_DB_PATH is configured, but ChatGPT itself should use OAuth/OIDC.
# MCP_API_KEY=your-secret-bearer-token

# Multi-user registry. Required for OIDC because a verified identity is mapped
# to an existing registry user before personal Odoo credentials are loaded.
# TOKEN_ENCRYPTION_KEY and .token_salt MUST match the registry owner's values.
# USERS_DB_PATH=/registry/users.db
# TOKEN_ENCRYPTION_KEY=must-equal-registry-value
# TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/token_encryption_key

# OAuth/OIDC (ChatGPT-compatible). Keycloak example:
# MCP_AUTH_MODE=oidc
# MCP_PUBLIC_URL=https://mcp.example.com
# MCP_OIDC_ISSUER=https://auth.example.com/realms/engineering
# Optional; Keycloak default is derived from issuer automatically:
# MCP_OIDC_JWKS_URI=https://auth.example.com/realms/engineering/protocol/openid-connect/certs
# Strongly recommended in production after adding a Keycloak audience mapper:
# MCP_OIDC_AUDIENCE=kasbifydev-mcp
# Claims/scopes:
# MCP_OIDC_EMAIL_CLAIM=email
# MCP_OIDC_SCOPES=openid,profile,email
# MCP_OIDC_ALGORITHM=RS256
# MCP_RESOURCE_NAME=KasbifyDev Odoo MCP

# Safety Layer (v1.10.0)
# MCP_SAFETY_MODE=strict        # strict (default) or permissive
# MCP_SAFETY_AUDIT=true         # Enable audit logging to stderr

# DX (v1.11.0)
# MCP_DEFAULT_CONTEXT={"lang": "fr_FR", "tz": "Europe/Paris"}
# MCP_BOOTSTRAP_MODELS=res.partner,sale.order,account.move,product.product,stock.picking
